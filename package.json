{
  "name": "personal-photos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prune-native-runtime.mjs && node scripts/check-snowflake-runtime.cjs",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "lint": "oxlint",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:search-acceptance": "node scripts/search/check-interpretation.mjs",
    "test:smoke": "node scripts/smoke-production.mjs",
    "release:check": "python3 scripts/release/check.py",
    "release": "python3 scripts/release/deploy.py --connection stillmark-deploy --deploy",
    "release:postcheck": "node scripts/release/postcheck.mjs",
    "backup:verify": "python3 scripts/verify-backup.py",
    "migrations:check": "python3 scripts/release/migrations.py check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:check": "python3 scripts/release/check_setup.py",
    "config:check": "node scripts/render-deployment.mjs",
    "config:render": "node scripts/render-deployment.mjs --write",
    "test:load-harness": "node --test scripts/load-test/*.test.mjs",
    "test:database-gate": "python3 scripts/release/check_database.py",
    "test:client-recovery": "node scripts/verification/client-recovery.mjs",
    "postinstall": "node scripts/snowflake-deadline/install.cjs",
    "test:ai-admission-postgres": "node scripts/verification/photo-ai-admission.mjs",
    "test:cleanup-postgres": "node scripts/verification/stage-cleanup.mjs",
    "profile:image-renditions": "node scripts/verification/image-renditions.mjs",
    "test:inference-retention-postgres": "node scripts/verification/photo-inference-retention.mjs",
    "test:travel-summaries-postgres": "node scripts/verification/travel-summaries.mjs",
    "test:gallery-statistics-postgres": "node scripts/verification/gallery-statistics.mjs",
    "test:gallery-statistics-writes": "node scripts/verification/gallery-statistics-write-benchmark.mjs",
    "docs:check": "node scripts/docs/check-links.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.1",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "hls.js": "^1.7.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "snowflake-sdk": "3.4.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-pgvector": "0.0.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/snowflake-sdk": "^1.11.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "fflate": "^0.8.3",
    "jsdom": "31.0.1",
    "oxlint": "^1.94.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "smol-toml": "^1.7.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "axios": "^1.16.1",
    "postcss": "^8.5.23",
    "toml": "^5.0.1",
    "nanoid": "^3.3.18",
    "baseline-browser-mapping": "^2.11.0",
    "@azure/msal-node": "7.1.1",
    "archiver@^8.0.0": {
      "readdir-glob@3.0.0": {
        "minimatch": "11.0.5"
      }
    }
  }
}
