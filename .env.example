# Copy to .env.local (ignored by Git) for local development. Never commit real values.
# See docs/DEVELOPMENT.md. Use an isolated development database, never production.

# PostgreSQL: set every value explicitly so the code never falls back to a local
# service definition that may point at production.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=stillmark_dev
PG_USER=stillmark_dev_app
PG_PASSWORD=
PG_SSL=false
# PG_SSL_ROOT_CERT=certs/postgres-root.crt   # required for any remote database

# Snowflake connection name from your local Snowflake CLI configuration.
# SNOWFLAKE_CONNECTION_NAME=stillmark-test

# Optional map tiles; without it the OSM tile proxy is used. See docs/MAPS.md.
# SNOWFLAKE_SECRET_CARTO_BASEMAPS_SECRET_STRING=
